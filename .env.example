PROJECT_NAME=CommerceLens-AI
VERSION=1.0.0

# LLM Keys
OPENAI_API_KEY=your_openai_key
GEMINI_API_KEY=your_gemini_key
GROQ_API_KEY=your_groq_key
SERPAPI_KEY=your_serpapi_key_here

# Database
DATABASE_URL=sqlite+aiosqlite:///./commerce_lens.db

# Production Tracking (Sentry)
SENTRY_DSN=your_sentry_dsn_here

# AI Tracing (LangSmith)
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=commerce-lens-ai


# Proxy Configuration (Bypass Amazon Sign-in Wall)
# Use a residential proxy (e.g. Webshare) for best results
PROXY_URL=http://username:password@p.webshare.io:80
# External Scraping APIs (Optional / Backup)
SERPAPI_KEY=your_serpapi_key_here
